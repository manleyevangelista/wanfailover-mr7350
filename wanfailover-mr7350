#!/bin/sh /etc/rc.common
# WAN Failover for Linksys MR7350 on OpenWRT
# Location:  /etc/init.d/wanfailover-mr7350
# Version 1 by manleyevangelista

USE_PROCD=1
START=98
STOP=01
NAME=wanfailover-mr7350

start_service() {
    procd_open_instance
    logger -t "${NAME}" "Service starting..."
    procd_set_param command /etc/wanfailover_monitor.sh
    procd_set_param respawn \
      ${respawn_threshold:-3600} \
      ${respawn_timeout:-5} \
      ${respawn_retry:-5}
    procd_set_param pidfile /var/run/${NAME}.pid

    # Enable log capture for stdout/stderr
    #procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance
}


